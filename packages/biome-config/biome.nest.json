{
  "root": false,
  "linter": {
    "rules": {
      "style": {
        "useNamingConvention": "off",
        "noParameterProperties": "off",
        "useImportType": "off"
      },
      "complexity": {
        "noUselessConstructor": "off"
      },
      "correctness": {
        "noUnusedVariables": "warn",
        "noUnusedPrivateClassMembers": "off"
      }
    }
  },
  "javascript": {
    "globals": ["process", "Buffer", "console", "__dirname", "__filename"]
  }
}
