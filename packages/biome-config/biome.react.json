{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": false,
  "linter": {
    "enabled": true,
    "domains": {
      "react": "recommended",
      "tailwind": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "correctness": {
        "useExhaustiveDependencies": "error"
      },
      "style": {
        "useComponentExportOnlyModules": "error"
      }
    }
  }
}
